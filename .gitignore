node_modules/
.next/
dist/
out/
build/

.env
.env.local
.env.*.local
# Real production secrets, not a template: same values as `.env`, pointed at
# the live database. `.env` above does not match it — the pattern is literal.
.env.prod
!.env.example

# A named tunnel's config carries the tunnel UUID and the path to its
# credentials file. The template beside it is the one to commit.
cloudflared/config.yml

*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Generated by `apps/web/scripts/build-sw.mjs` from `src/sw/sw.js`. Committing
# it would mean reviewing a bundled, minified copy of Workbox on every change.
apps/web/public/sw.js

.turbo/
*.tsbuildinfo
coverage/
.vercel

# Code assistants. `.github/*` rather than `.github`: git does not descend
# into an excluded directory, so a negation under one never matches and the
# workflows would be ignored the moment a new one is added.
.claude/
.github/*
!.github/workflows/

# The sound files the app serves live in `apps/web/public/sounds/`, which is
# committed. This is the drop folder the originals arrived in; committing it
# too would put the same bytes in the repository twice.
notification_sounds/

# WSL writes one of these beside every file copied in from Windows.
*:Zone.Identifier
